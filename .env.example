# Copiá este archivo a `.env` y completá los valores.
#   cp .env.example .env
# `.env` está en .gitignore: no se commitea nunca. Este archivo (.env.example)
# sí se commitea y solo lleva placeholders: el repo es público.

# Sitio de Jira (la URL base, sin barra final).
JIRA_SITE=https://bosch-aura.atlassian.net

# Email de la cuenta de Atlassian con la que se creó el token.
JIRA_EMAIL=tu-email@ejemplo.com

# Token de API de Atlassian.
# Se crea en: https://id.atlassian.com/manage-profile/security/api-tokens
# Tratalo como una contraseña: no lo pegues en chats, tickets ni PRs.
# Cuando termine la tarea, revocalo y generá otro.
JIRA_API_TOKEN=pegá-acá-tu-token

# Clave del proyecto de Jira donde viven los tickets (A2-123, A2-129, ...).
JIRA_PROJECT_KEY=A2
