<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bfmc_bringup</name>
  <version>0.0.1</version>
  <description>Arranca todo el sistema AURA con un solo comando.</description>
  <maintainer email="martina.dejesus@ing.austral.edu.ar">AURA Team</maintainer>
  <license>MIT</license>

  <exec_depend>bfmc_camera</exec_depend>
  <exec_depend>bfmc_lane_detection</exec_depend>
  <exec_depend>bfmc_sign_detection</exec_depend>
  <exec_depend>bfmc_control</exec_depend>
  <exec_depend>bfmc_hardware_bridge</exec_depend>
  <exec_depend>bfmc_decision</exec_depend>
  <exec_depend>bfmc_maneuvers</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
